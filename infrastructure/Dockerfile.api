FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY nexus ./nexus

RUN pip install --no-cache-dir . && pip install --no-cache-dir psycopg2-binary

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import httpx; httpx.get('http://localhost:8000/api/v1/health').raise_for_status()"

CMD ["python", "-m", "nexus.cli", "runserver", "--host", "0.0.0.0", "--port", "8000"]
