# ---- NEXUS configuration (copy to .env and edit) ----
# Database: SQLite by default for local dev; use Postgres in production
NEXUS_DATABASE_URL=sqlite:///./nexus.db

# Logging: DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_LEVEL=INFO
NEXUS_LOG_FILE=./logs/nexus.log

# Data provider: "demo" (deterministic synthetic), "rpc" (Ethereum JSON-RPC)
NEXUS_DATA_PROVIDER=demo

# For the rpc provider
NEXUS_RPC_URL=
NEXUS_ETHERSCAN_API_KEY=

# LLM provider: echo (deterministic, evidence-only) | openai | anthropic | ollama
NEXUS_LLM_PROVIDER=echo
NEXUS_LLM_MODEL=
# API keys are read from the environment only - never hard-code secrets
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEXUS_OLLAMA_BASE_URL=http://localhost:11434

# Alerts
NEXUS_SMTP_HOST=
NEXUS_SMTP_PORT=587
NEXUS_SMTP_USER=
NEXUS_SMTP_PASSWORD=
NEXUS_ALERT_EMAIL_TO=
NEXUS_SLACK_WEBHOOK_URL=

# Feature/model artifacts
NEXUS_ARTIFACTS_DIR=./artifacts
